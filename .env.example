# SeeMee runs with zero environment variables.
# `npm run dev` uses the in-memory demo store, placeholder video,
# instant coin purchases, in-app notifications, and demo sign-in.

# App origin used for OAuth and Stripe return URLs.
# Defaults to the incoming request host.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# memory (default) or supabase.
# supabase requires the URL and service role key below, plus the SQL migration.
SEEMEE_DATA_SOURCE=memory
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LiveKit. When all three are set, viewers and the studio join a real room.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=

# Stripe Checkout. Coins are credited from the webhook and from the success redirect.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# OneSignal. External user id is the SeeMee user id.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
NEXT_PUBLIC_ONESIGNAL_APP_ID=

# Cloudflare Stream live inputs. Optional customer code builds an HLS playback URL.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=

# OAuth. Missing values keep the provider buttons on demo sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
